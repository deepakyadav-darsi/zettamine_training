CLASS lcl_handler DEFINITION
  INHERITING FROM cl_abap_behavior_event_handler.
  PRIVATE SECTION.
   METHODS on_emp_created FOR ENTITY EVENT
      IMPORTING new_emp
        FOR zdpk_employees_un_m~employeeEnrolled.
ENDCLASS.


CLASS lcl_handler IMPLEMENTATION.

  METHOD on_emp_created.
  data log type table for create zdpk_employees_un_m .

  LOOP AT new_emp ASSIGNING FIELD-SYMBOL(<travel>).
    APPEND VALUE #( id = <travel>-id
                     )
      TO log.
      endloop.

      MODIFY ENTITIES OF zdpk_employees_un_m
  ENTITY zdpk_employees_un_m
    CREATE AUTO FILL CID
    FIELDS ( name )
    WITH log.
  ENDMETHOD.

ENDCLASS.
